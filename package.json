{
  "name": "creator-developer-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/optimizeImages.mjs && node server/index.js & vite",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "node scripts/optimizeImages.mjs && vite build && node scripts/check-bundle.mjs",
    "start": "NODE_ENV=production node server/index.js",
    "preview": "vite preview",
    "optimize:images": "node scripts/optimizeImages.mjs",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "bash supabase/tests/run_tests.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run lint && npm test && npm run test:db && npm run test:e2e && npm run build && npm run test:smoke",
    "test:smoke": "node scripts/smoke-built-app.mjs"
  },
  "dependencies": {
    "@sentry/react": "^8.47.0",
    "@supabase/supabase-js": "^2.39.0",
    "clsx": "^2.0.0",
    "cors": "^2.8.5",
    "date-fns": "^3.0.0",
    "express": "^4.21.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.21.0",
    "recharts": "^2.10.3",
    "resend": "^6.37.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.8",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "qs": "^6.17.1"
  }
}

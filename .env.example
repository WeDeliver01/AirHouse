# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from: Supabase Dashboard > Settings > API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# IMPORTANT: SUPABASE SETUP FOR AUTH TO WORK
# ============================================
#
# STEP 1: Create Supabase Project
# - Go to https://supabase.com/dashboard
# - Create a new project
#
# STEP 2: Configure Authentication
# - Go to Authentication > Providers > Email
# - Make sure "Enable Email provider" is ON
# - Set "Confirm email" to OFF (for easier testing)
#
# STEP 3: Configure URLs
# - Go to Authentication > URL Configuration
# - Site URL: http://localhost:5173
# - Add to Redirect URLs: http://localhost:5173/auth/callback
#
# STEP 4: Run Database Migration
# - Go to SQL Editor
# - Copy the contents of: supabase/migrations/004_schema_v3_wallets.sql
# - Paste and click "Run"
#
# STEP 5: Copy API Keys
# - Go to Settings > API
# - Copy "Project URL" to VITE_SUPABASE_URL
# - Copy "anon public" key to VITE_SUPABASE_ANON_KEY

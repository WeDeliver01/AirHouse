# ============================================
# AIRHOUSE ENVIRONMENT CONFIGURATION
# ============================================
# Copy to .env for local development. In staging and production these values
# must come from the hosting provider's secret manager, never from a file in
# the repository. The server refuses to start in production if any required
# value is missing (see server/config.js).

# --------------------------------------------
# FRONTEND (Vite) — exposed to the browser
# --------------------------------------------
# Only put values here that are safe to be public. The Supabase anon key is
# designed to be public; the service-role key is NOT and must never carry a
# VITE_ prefix.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --------------------------------------------
# NOTIFICATION SERVER (Express) — server-side only
# --------------------------------------------
NODE_ENV=development
PORT=3001

# Used to verify the caller's access token and to authorize recipients.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Trusted backend credential. Grants full database access — keep it out of the
# browser bundle, out of git, and rotate it if it is ever exposed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email delivery (Resend). Replaces the previous Replit connector lookup.
RESEND_API_KEY=
RESEND_FROM_EMAIL=AirHouse <notifications@airhouse.co.za>

# CORS allowlist — comma separated, exact origins. Required in production;
# there is no wildcard fallback.
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173

# Addresses the platform may email even though they are not platform users.
SUPPORT_INBOX_EMAILS=support@airhouse.co.za

# Public URL used for links inside emails.
APP_URL=http://localhost:5000

# --------------------------------------------
# ABUSE CONTROLS (optional — defaults shown)
# --------------------------------------------
# NOTE: rate limit counters are per process. Move to a shared store before
# running more than one instance. See docs/RISK_REGISTER.md (AH-004).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_USER=20
RATE_LIMIT_MAX_PER_IP=60
RATE_LIMIT_MAX_PUBLIC_LEAD=5
MAX_BATCH_SIZE=50
MAX_REQUEST_BODY=64kb

# --------------------------------------------
# PAYMENTS
# --------------------------------------------
# Gateway selection is fail-closed: production builds refuse the 'test'
# gateway. Valid values: test | yoco | bobpay
VITE_PAYMENT_GATEWAY=test

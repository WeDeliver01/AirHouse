# AirHouse — production environment for airhouse.co.za
#
# Copy to deploy/.env.production on the server and fill in. That file is
# gitignored and must never be committed.
#
#   cp deploy/.env.production.example deploy/.env.production
#   chmod 600 deploy/.env.production
#
# The server refuses to start in production if any value marked REQUIRED is
# missing. That is deliberate: a half-configured deployment that boots and
# then fails on every request is harder to diagnose than one that refuses.

# ============================================================
# BUILD-TIME (baked into the JavaScript bundle)
# ============================================================
# Changing any of these means rebuilding the image, not restarting it.
# Only put values here that are safe to be public — anyone can read them in
# the browser. The Supabase anon key is designed for this; the service role
# key is NOT and appears further down, runtime-only.

# REQUIRED
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# REQUIRED
VITE_SUPABASE_ANON_KEY=

VITE_ENVIRONMENT=production

# Set by the deploy script to the deployed commit, so Sentry can tie an error
# to a release.
VITE_RELEASE=

# Error monitoring. Without it, production runs blind.
VITE_SENTRY_DSN=

# Stays 'test' until a real provider is integrated. A production build
# refuses to use the simulated gateway for an actual payment, so this does
# not put money at risk; the platform runs on bank transfer.
VITE_PAYMENT_GATEWAY=test

# Bank details shown to a developer funding a campaign by EFT. Without the
# account number and branch code the funding screen tells them to contact
# support instead of showing incomplete instructions.
VITE_BANK_ACCOUNT_NAME=AirHouse (Pty) Ltd
VITE_BANK_NAME=
VITE_BANK_ACCOUNT_NUMBER=
VITE_BANK_BRANCH_CODE=

# ============================================================
# RUNTIME (server only — never reaches the browser)
# ============================================================

# REQUIRED — same project as VITE_SUPABASE_URL.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# REQUIRED
SUPABASE_ANON_KEY=

# REQUIRED. Full database access, bypassing Row Level Security. Keep it off
# the browser, out of git, and rotate it if it is ever exposed.
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED — email delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=AirHouse <notifications@airhouse.co.za>

# REQUIRED — exact origins, comma separated. No wildcard fallback exists.
# Include www only if you serve it; the Nginx config redirects it to the
# apex, so normally this is just the apex.
ALLOWED_ORIGINS=https://airhouse.co.za

# Used for links inside emails.
APP_URL=https://airhouse.co.za

# Addresses the platform may email even though they are not platform users.
SUPPORT_INBOX_EMAILS=support@airhouse.co.za

# ============================================================
# HOST
# ============================================================
# Local port the container binds to on 127.0.0.1. Must match the upstream in
# deploy/nginx/airhouse.co.za.conf. Change it if 5000 is already taken by
# something else on this box.
APP_PORT=5000

# Leave headroom for the other sites on the VPS.
APP_CPU_LIMIT=1.0
APP_MEMORY_LIMIT=512M

# ============================================================
# ABUSE CONTROLS (optional — defaults shown)
# ============================================================
# NOTE: these counters live in one process's memory. Running more than one
# replica multiplies the effective limit. See AH-019 in docs/RISK_REGISTER.md.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_USER=20
RATE_LIMIT_MAX_PER_IP=60
RATE_LIMIT_MAX_PUBLIC_LEAD=5
MAX_BATCH_SIZE=50
MAX_REQUEST_BODY=64kb
